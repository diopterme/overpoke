{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "overpoke",
  "version": "0.1.0",
  "identifier": "me.diopter.overpoke",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Diopterme",
    "licenseFile": "notice.txt",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["Korean"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
