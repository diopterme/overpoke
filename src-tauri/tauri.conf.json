{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "overpoke",
  "version": "0.1.1",
  "identifier": "me.diopter.overpoke",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Diopterme",
    "licenseFile": "notice.txt",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["Korean"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMEFGOEQ4NjdFRkIwMEIKUldRTHNPOW4yUGdLckMwM0N4Tk10ZU54TUhFMkxsQnYvOWFDNmh3Q0liRmxTZnNhL1pBaG5DK3kK",
      "endpoints": [
        "https://github.com/diopterme/overpoke/releases/latest/download/latest.json"
      ]
    }
  }
}
